# Upstash Redis (wajib)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# JWT Secret — ganti dengan string acak panjang minimal 32 karakter
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-char

# Webhook Secret — untuk verifikasi HMAC-SHA256 signature
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=ganti-dengan-secret-webhook-acak-panjang

# Base URL aplikasi (untuk CORS & payment link)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
